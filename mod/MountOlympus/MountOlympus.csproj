<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <Title>Mount Olympus</Title>
    <Authors>jbs4bmx</Authors>
    <Copyright>jbs4bmx 2018-2026</Copyright>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Version>4.1.3.10</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Misc\**" />
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Misc\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Misc\**" />
    <None Remove="Properties\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SemanticVersioning">
      <HintPath>T:\SPT\SPT_Runtime\SemanticVersioning.dll</HintPath>
    </Reference>
    <Reference Include="SPT.Server">
      <HintPath>T:\SPT\SPT_Runtime\SPT.Server.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>T:\SPT\SPT_Runtime\SPTarkov.Common.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>T:\SPT\SPT_Runtime\SPTarkov.DI.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>T:\SPT\SPT_Runtime\SPTarkov.Reflection.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Server.Assets">
      <HintPath>T:\SPT\SPT_Runtime\SPTarkov.Server.Assets.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>T:\SPT\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Hashing">
      <HintPath>T:\SPT\SPT_Runtime\System.IO.Hashing.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
